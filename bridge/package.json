{
  "name": "antiremote-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted remote control bridge for Google Antigravity CLI (agy) and AntiRemote iOS client",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "antiremote-bridge": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node ./src/cli.mjs",
    "start:mock": "node ./src/cli.mjs --adapter mock",
    "test": "node --test ./test/bridge.test.mjs"
  }
}
